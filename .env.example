# Токен OpenRouter (https://openrouter.ai/keys) — обязателен для работы чата.
# Никогда не коммитьте реальный .env с ключом.
OPENROUTER_API_KEY=

# Необязательно: переопределить приоритетный список моделей (через запятую).
# По умолчанию используется список из раздела 3 ТЗ.
# OPENROUTER_MODELS=qwen/qwen3-coder:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,openrouter/free

# Необязательно: порт сервера (по умолчанию 3000)
# PORT=3000

# Необязательно: путь к SQLite-базе (по умолчанию data/berka.db)
# DB_PATH=./data/berka.db
